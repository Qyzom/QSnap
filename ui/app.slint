import { ScrollView, LineEdit, Button, Slider } from "std-widgets.slint";
import "./fonts/Unbounded.ttf";

export struct LogItem {
    time: string,
    message: string,
    level: string,
}

export component AppWindow inherits Window {
    title: "QSnap - Video Studio";
    preferred-width: 1080px;
    preferred-height: 720px;
    min-width: 900px;
    min-height: 600px;
    background: #09090B;
    default-font-family: "Unbounded";

    // Callbacks to Rust
    callback start_batch_render();
    callback select_source_video();
    callback select_broll_folder();
    callback select_output_folder();
    callback save_template();
    callback generate_preview();

    // State properties
    in-out property <int> active_tab: 0;
    in-out property <string> source_video_path: "";
    in-out property <string> broll_folder_path: "";
    in-out property <string> output_folder_path: "";
    in-out property <string> banner_text: "Подпишись • Промокод: BONUS2026";
    in-out property <int> clip_duration_secs: 45;
    in-out property <int> clips_count: 10;
    in-out property <bool> snap_to_scenes: true;
    in-out property <string> preview_status: "Предпросмотр не сформирован";
    
    // Anti-fraud switches
    in-out property <bool> af_speed: true;
    in-out property <bool> af_pitch: true;
    in-out property <bool> af_zoom: true;
    in-out property <bool> af_grain: true;
    in-out property <bool> af_metadata: true;

    // Progress & Status
    in-out property <bool> is_rendering: false;
    in-out property <float> progress_percent: 0.0;
    in-out property <string> status_text: "Готов к нарезке";

    // Logs
    in-out property <[LogItem]> logs: [
        { time: "00:00:01", message: "QSnap Studio 0.1.0 запущена. Движок FFmpeg активен.", level: "INFO" },
    ];

    HorizontalLayout {
        padding: 0px;
        spacing: 0px;

        // ==================== LEFT SIDEBAR ====================
        Rectangle {
            width: 250px;
            background: #111113;

            VerticalLayout {
                padding: 20px;
                spacing: 16px;

                // Header Logo
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Image {
                        source: @image-url("images/logo.png");
                        width: 44px;
                        height: 44px;
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "QSnap";
                            font-size: 20px;
                            font-weight: 800;
                            color: #FFFFFF;
                        }
                        Text {
                            text: "STUDIO";
                            font-size: 10px;
                            font-weight: 700;
                            letter-spacing: 2px;
                            color: #71717A;
                        }
                    }
                }

                Rectangle { height: 1px; background: #27272A; }

                // Navigation Buttons
                VerticalLayout {
                    spacing: 8px;

                    // Tab 0: Generator
                    Rectangle {
                        height: 44px;
                        border-radius: 8px;
                        background: root.active_tab == 0 ? #27272A : transparent;
                        border-width: root.active_tab == 0 ? 1px : 0px;
                        border-color: #3F3F46;
                        TouchArea { clicked => { root.active_tab = 0; } }
                        Text {
                            x: 16px;
                            y: 13px;
                            text: "Генерация серии";
                            color: root.active_tab == 0 ? #FFFFFF : #A1A1AA;
                            font-size: 13px;
                            font-weight: 600;
                        }
                    }

                    // Tab 1: Template
                    Rectangle {
                        height: 44px;
                        border-radius: 8px;
                        background: root.active_tab == 1 ? #27272A : transparent;
                        border-width: root.active_tab == 1 ? 1px : 0px;
                        border-color: #3F3F46;
                        TouchArea { clicked => { root.active_tab = 1; } }
                        Text {
                            x: 16px;
                            y: 13px;
                            text: "Редактор шаблона";
                            color: root.active_tab == 1 ? #FFFFFF : #A1A1AA;
                            font-size: 13px;
                            font-weight: 600;
                        }
                    }

                    // Tab 2: Anti-Fraud
                    Rectangle {
                        height: 44px;
                        border-radius: 8px;
                        background: root.active_tab == 2 ? #27272A : transparent;
                        border-width: root.active_tab == 2 ? 1px : 0px;
                        border-color: #3F3F46;
                        TouchArea { clicked => { root.active_tab = 2; } }
                        Text {
                            x: 16px;
                            y: 13px;
                            text: "Антифрод и уникализация";
                            color: root.active_tab == 2 ? #FFFFFF : #A1A1AA;
                            font-size: 13px;
                            font-weight: 600;
                        }
                    }

                    // Tab 3: Logs
                    Rectangle {
                        height: 44px;
                        border-radius: 8px;
                        background: root.active_tab == 3 ? #27272A : transparent;
                        border-width: root.active_tab == 3 ? 1px : 0px;
                        border-color: #3F3F46;
                        TouchArea { clicked => { root.active_tab = 3; } }
                        Text {
                            x: 16px;
                            y: 13px;
                            text: "Консоль и логи";
                            color: root.active_tab == 3 ? #FFFFFF : #A1A1AA;
                            font-size: 13px;
                            font-weight: 600;
                        }
                    }
                }

                Rectangle { height: 100%; } // Spacer

                // Bottom engine status pill
                Rectangle {
                    height: 48px;
                    border-radius: 8px;
                    background: #18181B;
                    border-width: 1px;
                    border-color: #27272A;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        alignment: center;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: root.is_rendering ? #A1A1AA : #FFFFFF;
                        }
                        Text {
                            text: root.is_rendering ? "Идет нарезка" : "Готов к работе";
                            color: #A1A1AA;
                            font-size: 11px;
                        }
                    }
                }
            }
        }

        // ==================== MAIN CONTENT AREA ====================
        Rectangle {
            background: #09090B;

            VerticalLayout {
                padding: 24px;
                spacing: 20px;

                // Tab 0: BATCH GENERATOR PAGE
                if root.active_tab == 0 : VerticalLayout {
                    spacing: 16px;

                    Text {
                        text: "Пакетная нарезка серии роликов";
                        font-size: 20px;
                        font-weight: 700;
                        color: #FFFFFF;
                    }

                    // Source Video Selector Card
                    Rectangle {
                        height: 80px;
                        background: #141416;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #27272A;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 16px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;
                                Text {
                                    text: "Исходный видеофайл:";
                                    font-size: 12px;
                                    color: #A1A1AA;
                                }
                                Text {
                                    text: root.source_video_path != "" ? root.source_video_path : "Файл не выбран (нажмите для выбора)";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: root.source_video_path != "" ? #FFFFFF : #52525B;
                                    overflow: elide;
                                }
                            }
                            Rectangle {
                                width: 140px;
                                height: 40px;
                                border-radius: 8px;
                                background: #27272A;
                                border-width: 1px;
                                border-color: #3F3F46;
                                TouchArea { clicked => { root.select_source_video(); } }
                                Text {
                                    text: "Выбрать файл";
                                    font-size: 12px;
                                    color: #FFFFFF;
                                    font-weight: 600;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                    }

                    // B-Roll Gameplay Folder Card
                    Rectangle {
                        height: 80px;
                        background: #141416;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #27272A;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 16px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;
                                Text {
                                    text: "Каталог B-roll видеоряда (геймплей, анимация):";
                                    font-size: 12px;
                                    color: #A1A1AA;
                                }
                                Text {
                                    text: root.broll_folder_path != "" ? root.broll_folder_path : "Папка не выбрана";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: root.broll_folder_path != "" ? #FFFFFF : #52525B;
                                    overflow: elide;
                                }
                            }
                            Rectangle {
                                width: 140px;
                                height: 40px;
                                border-radius: 8px;
                                background: #27272A;
                                border-width: 1px;
                                border-color: #3F3F46;
                                TouchArea { clicked => { root.select_broll_folder(); } }
                                Text {
                                    text: "Выбрать папку";
                                    font-size: 12px;
                                    color: #FFFFFF;
                                    font-weight: 600;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                    }

                    // Settings: Clips count & duration
                    HorizontalLayout {
                        spacing: 16px;

                        Rectangle {
                            height: 70px;
                            background: #141416;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #27272A;
                            VerticalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: center;
                                spacing: 4px;
                                Text { text: "Количество клипов в серии:"; font-size: 11px; color: #A1A1AA; }
                                LineEdit {
                                    text: root.clips_count;
                                    font-size: 14px;
                                    edited(val) => { root.clips_count = 10; }
                                }
                            }
                        }

                        Rectangle {
                            height: 70px;
                            background: #141416;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #27272A;
                            VerticalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: center;
                                spacing: 4px;
                                Text { text: "Длительность клипа (сек):"; font-size: 11px; color: #A1A1AA; }
                                LineEdit {
                                    text: root.clip_duration_secs;
                                    font-size: 14px;
                                    edited(val) => { root.clip_duration_secs = 45; }
                                }
                            }
                        }
                    }

                    // Banner Text Quick Edit
                    Rectangle {
                        height: 70px;
                        background: #141416;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #27272A;
                        VerticalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            alignment: center;
                            spacing: 4px;
                            Text { text: "Текст центрального баннера:"; font-size: 11px; color: #A1A1AA; }
                            LineEdit {
                                text: root.banner_text;
                                font-size: 13px;
                                edited(val) => { root.banner_text = val; }
                            }
                        }
                    }

                    Rectangle { height: 6px; }

                    // Progress bar
                    Rectangle {
                        height: 10px;
                        border-radius: 5px;
                        background: #1F1F23;
                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: root.progress_percent * parent.width;
                            height: parent.height;
                            border-radius: 5px;
                            background: #FFFFFF;
                        }
                    }

                    Text {
                        text: root.status_text;
                        font-size: 12px;
                        color: #A1A1AA;
                        horizontal-alignment: center;
                    }

                    // Big Action Button
                    Rectangle {
                        height: 52px;
                        border-radius: 8px;
                        background: root.is_rendering ? #27272A : #FFFFFF;
                        TouchArea {
                            clicked => {
                                if (!root.is_rendering) {
                                    root.start_batch_render();
                                }
                            }
                        }
                        Text {
                            text: root.is_rendering ? "Идет рендеринг видеосерии..." : "ЗАПУСТИТЬ НАРЕЗКУ И УНИКАЛИЗАЦИЮ";
                            font-size: 13px;
                            font-weight: 800;
                            color: root.is_rendering ? #71717A : #09090B;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                // Tab 1: TEMPLATE EDITOR PAGE
                if root.active_tab == 1 : VerticalLayout {
                    spacing: 16px;
                    Text { text: "Редактор шаблона Split-Screen"; font-size: 20px; font-weight: 700; color: #FFFFFF; }
                    
                    HorizontalLayout {
                        spacing: 20px;

                        // Canvas Visual 9:16 Mockup
                        Rectangle {
                            width: 220px;
                            height: 390px;
                            background: #000000;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: #3F3F46;

                            VerticalLayout {
                                padding: 4px;
                                spacing: 0px;

                                // Top layer (Content)
                                Rectangle {
                                    height: 180px;
                                    background: #18181B;
                                    border-radius: 8px;
                                    Text {
                                        text: "ОСНОВНОЙ КОНТЕНТ\n50% высоты";
                                        font-size: 10px;
                                        color: #FFFFFF;
                                        horizontal-alignment: center;
                                        y: 75px;
                                    }
                                }

                                // Center Banner
                                Rectangle {
                                    height: 34px;
                                    background: #0A0A0C;
                                    border-width: 1px;
                                    border-color: #27272A;
                                    Text {
                                        text: root.banner_text;
                                        font-size: 8px;
                                        font-weight: 700;
                                        color: #FFFFFF;
                                        horizontal-alignment: center;
                                        overflow: elide;
                                        y: 10px;
                                    }
                                }

                                // Bottom layer (Retention Gameplay)
                                Rectangle {
                                    height: 170px;
                                    background: #111113;
                                    border-radius: 8px;
                                    Text {
                                        text: "B-ROLL / ГЕЙМПЛЕЙ\n50% высоты";
                                        font-size: 10px;
                                        color: #71717A;
                                        horizontal-alignment: center;
                                        y: 70px;
                                    }
                                }
                            }
                        }

                        // Right configuration controls
                        VerticalLayout {
                            spacing: 14px;

                            Rectangle {
                                height: 75px;
                                background: #141416;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: #27272A;
                                VerticalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    alignment: center;
                                    spacing: 4px;
                                    Text { text: "Текст центрального баннера:"; font-size: 12px; color: #A1A1AA; }
                                    LineEdit {
                                        text: root.banner_text;
                                        font-size: 13px;
                                        edited(val) => { root.banner_text = val; }
                                    }
                                }
                            }

                            Rectangle {
                                height: 75px;
                                background: #141416;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: #27272A;
                                VerticalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    alignment: center;
                                    spacing: 4px;
                                    Text { text: "Разрешение холста:"; font-size: 12px; color: #A1A1AA; }
                                    Text { text: "1080 x 1920 (Формат 9:16 Shorts / TikTok / Reels)"; font-size: 13px; font-weight: 700; color: #FFFFFF; }
                                }
                            }

                            Rectangle {
                                height: 75px;
                                background: #141416;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: #27272A;
                                VerticalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    alignment: center;
                                    spacing: 4px;
                                    Text { text: "Шрифт субтитров и баннера:"; font-size: 12px; color: #A1A1AA; }
                                    Text { text: "Unbounded Bold"; font-size: 13px; font-weight: 700; color: #FFFFFF; }
                                }
                            }

                            // Preview generation button
                            Rectangle {
                                height: 46px;
                                border-radius: 8px;
                                background: #27272A;
                                border-width: 1px;
                                border-color: #3F3F46;
                                TouchArea { clicked => { root.generate_preview(); } }
                                Text {
                                    text: "Тестовый рендер 1 кадра";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: #FFFFFF;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }

                            Text {
                                text: root.preview_status;
                                font-size: 11px;
                                color: #A1A1AA;
                            }
                        }
                    }
                }

                // Tab 2: ANTI-FRAUD SETTINGS PAGE
                if root.active_tab == 2 : VerticalLayout {
                    spacing: 16px;
                    Text { text: "Настройки алгоритмов антифрода и уникализации"; font-size: 20px; font-weight: 700; color: #FFFFFF; }
                    Text { text: "Эти фильтры изменяют цифровой хэш каждого ролика в серии, предотвращая блокировку и shadowban."; font-size: 12px; color: #A1A1AA; }

                    VerticalLayout {
                        spacing: 10px;

                        Rectangle {
                            height: 56px;
                            background: #141416;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272A;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                alignment: space-between;
                                Text { text: "Микро-ускорение видео (1.01x – 1.04x)"; font-size: 13px; color: #FFFFFF; vertical-alignment: center; }
                                Text { text: root.af_speed ? "АКТИВНО" : "ОТКЛЮЧЕНО"; color: root.af_speed ? #FFFFFF : #52525B; font-weight: 700; font-size: 12px; vertical-alignment: center; }
                            }
                        }

                        Rectangle {
                            height: 56px;
                            background: #141416;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272A;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                alignment: space-between;
                                Text { text: "Сдвиг аудио-питча (Pitch Jitter)"; font-size: 13px; color: #FFFFFF; vertical-alignment: center; }
                                Text { text: root.af_pitch ? "АКТИВНО" : "ОТКЛЮЧЕНО"; color: root.af_pitch ? #FFFFFF : #52525B; font-weight: 700; font-size: 12px; vertical-alignment: center; }
                            }
                        }

                        Rectangle {
                            height: 56px;
                            background: #141416;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272A;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                alignment: space-between;
                                Text { text: "Микро-зум и случайный кроп (2-4%)"; font-size: 13px; color: #FFFFFF; vertical-alignment: center; }
                                Text { text: root.af_zoom ? "АКТИВНО" : "ОТКЛЮЧЕНО"; color: root.af_zoom ? #FFFFFF : #52525B; font-weight: 700; font-size: 12px; vertical-alignment: center; }
                            }
                        }

                        Rectangle {
                            height: 56px;
                            background: #141416;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272A;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                alignment: space-between;
                                Text { text: "Добавление легкого цифрового шума (Grain)"; font-size: 13px; color: #FFFFFF; vertical-alignment: center; }
                                Text { text: root.af_grain ? "АКТИВНО" : "ОТКЛЮЧЕНО"; color: root.af_grain ? #FFFFFF : #52525B; font-weight: 700; font-size: 12px; vertical-alignment: center; }
                            }
                        }

                        Rectangle {
                            height: 56px;
                            background: #141416;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #27272A;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                alignment: space-between;
                                Text { text: "Полная очистка метаданных (-map_metadata -1)"; font-size: 13px; color: #FFFFFF; vertical-alignment: center; }
                                Text { text: root.af_metadata ? "АКТИВНО" : "ОТКЛЮЧЕНО"; color: root.af_metadata ? #FFFFFF : #52525B; font-weight: 700; font-size: 12px; vertical-alignment: center; }
                            }
                        }
                    }
                }

                // Tab 3: LOGS PAGE
                if root.active_tab == 3 : VerticalLayout {
                    spacing: 12px;
                    Text { text: "Консоль событий и рендеринга"; font-size: 20px; font-weight: 700; color: #FFFFFF; }

                    Rectangle {
                        background: #09090B;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #27272A;
                        ScrollView {
                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                for item in root.logs: HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: item.time; font-size: 11px; color: #71717A; width: 70px; }
                                    Text { text: item.message; font-size: 11px; color: #FAFAFA; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
